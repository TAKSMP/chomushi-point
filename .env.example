# Supabase プロジェクトの設定（Project Settings → API / Data API）
# どちらも「公開してよい値」です。データは DB 側の RLS で家族ごとに守られます。
# service_role キー / secret キー / DB パスワードは絶対にここへ書かないでください。
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# 旧形式の anon キーを使う場合は上の代わりに:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase 未設定のまま画面だけ試すとき true（この端末だけに保存。本番では使わない）
VITE_DEMO_MODE=false
